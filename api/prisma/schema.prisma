generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum UserType {
  PATIENT
  PSYCHOLOGIST
}

model Patient {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  appointments Appointment[]
}

model Psychologist {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Appointment {
  id         String            @id @default(uuid())
  status     AppointmentStatus
  starts_at  DateTime
  ends_at    DateTime
  notes      String?
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  patient_id String
  patient    Patient @relation(fields: [patient_id], references: [id])
}

model Session {
  id         String   @id @default(uuid())
  token      String   @unique //hash token
  expires_at DateTime
  created_at DateTime @default(now())

  // Polimorfismo controlado
  user_id   String // ID do Patient OU Psychologist
  user_type UserType // "PATIENT" | "PSYCHOLOGIST"

  @@index([user_id, user_type])
  @@index([expires_at]) // Para limpeza de expirados (cron job)
}
